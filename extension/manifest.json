{
  "manifest_version": 3,
  "name": "ZDownloader PRO • by Basit",
  "version": "3.6.0",
  "author": "Basit",
  "description": "Ultra-fast 1-click video & audio downloader created by Basit with 1-click cookie sync, side panel, in-page IDM-style buttons, tabs & background downloads.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "contextMenus",
    "notifications",
    "storage",
    "cookies",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://192.168.*:*/*",
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://fb.watch/*",
    "*://*.tiktok.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.pinterest.com/*",
    "*://*.reddit.com/*"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZDownloader PRO • by Basit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "quick-download": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "windows": "Alt+Shift+D"
      },
      "description": "Quick download current page video instantly"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://fb.watch/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.snapchat.com/*",
        "*://*.pinterest.com/*",
        "*://*.pin.it/*",
        "*://*.reddit.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}

